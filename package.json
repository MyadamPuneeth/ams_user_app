{
  "name": "ams",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @ams/web",
    "dev:api": "python -m uv run --project apps/api uvicorn ams_api.main:app --reload --host 127.0.0.1 --port 3001",
    "build": "npm run build --workspace @ams/web",
    "typecheck": "npm run typecheck --workspace @ams/web",
    "db:migrate": "node scripts/migrate.mjs",
    "contracts": "node scripts/contracts.mjs",
    "test": "node scripts/test-api.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "test:api": "node scripts/test-api.mjs"
  },
  "overrides": { "deepmerge-ts": "8.0.0" },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "async-exit-hook": "2.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "openapi-typescript": "^7.9.1",
    "pg": "^8.16.3",
    "typescript": "^5.9.3"
  }
}
